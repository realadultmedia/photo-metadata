{
    "name": "realadultmedia/photo-metadata",
    "description": "Strip location, camera and owner data from JPEG, PNG and WebP photos without re-encoding them.",
    "keywords": ["exif", "gps", "metadata", "privacy", "jpeg", "png", "webp", "xmp", "iptc"],
    "homepage": "https://github.com/realadultmedia/photo-metadata",
    "license": "MIT",
    "authors": [
        {
            "name": "Real Adult Media",
            "homepage": "https://www.realadult.media"
        }
    ],
    "support": {
        "issues": "https://github.com/realadultmedia/photo-metadata/issues",
        "security": "https://github.com/realadultmedia/photo-metadata/security/policy"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-gd": "Only used by the test suite to build sample images.",
        "ext-exif": "Only used by the test suite to read the orientation back."
    },
    "autoload": {
        "psr-4": {
            "RealAdultMedia\\PhotoMetadata\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RealAdultMedia\\PhotoMetadata\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
